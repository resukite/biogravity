# ====================================================================
# BioGravity Autonomous AI Publisher Environment Configuration
# ====================================================================

# 1. AI Research Model API Key (Gemini 3.8 Flash recommended)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Alternative Research Model API Key (Perplexity AI - Optional)
PERPLEXITY_API_KEY=

# 3. Licensed Image API (Unsplash Developer Key - Optional)
# If omitted, curated high-resolution scientific photography CDN links are used.
# Get free key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# 4. SEO & Canonical Domain
SITE_URL=https://biogravity.org

# 5. Publishing Volume & Schedule Controls
MAX_ARTICLES_PER_DAY=3
PUBLISH_HOURS=8,14,20
TIMEZONE=local
